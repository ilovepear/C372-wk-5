<%- include('partials/header',{title:'Book a service'}) %>
<div class="page-heading"><span class="eyebrow">CARE MADE SIMPLE</span><h1>A little pampering <em>goes a long way.</em></h1><p>Pick a care service and create a booking for your pet.</p></div>
<div class="two-cols service-layout"><section class="surface"><div class="card-heading"><div><span class="eyebrow">OUR SERVICES</span><h2>Choose what they need</h2></div></div><% if (!services.length) { %><div class="empty-state"><p>There are no services available right now.</p></div><% }else{%><div class="service-catalog"><% services.forEach(function(s){ %><div class="catalog-item"><span class="catalog-icon"><%= /Groom|Bath|Nail/.test(s.name)?'✂️':/Health|Vaccin|Dental/.test(s.name)?'💗':'🐾' %></span><div><strong><%= s.name %></strong><small>Quality pet care</small></div><strong class="price">S$<%= money(s.price) %></strong></div><%});%></div><%}%></section>
<section class="surface booking-panel"><span class="eyebrow">BOOK AN APPOINTMENT</span><h2>Let's get them cared for.</h2><p class="subtle">Bookings start as pending. No real payment will be collected.</p><% if (!pets.length) { %><div class="empty-state"><p>You need a pet profile before booking a service.</p><a class="btn btn-primary" href="/pets/new">+ Add a pet</a></div><% } else if (services.length) { %><form method="POST" action="/services/book" class="form-stack"><label>Your pet <select name="petId" required><option value="">Choose a pet</option><% pets.forEach(function(p){%><option value="<%= p.id %>" <%= selectedPetId===p.id?'selected':'' %>><%= p.name %></option><%});%></select></label><label>Care service <select name="serviceId" required><option value="">Choose a service</option><% services.forEach(function(s){%><option value="<%= s.id %>"><%= s.name %> — S$<%= money(s.price) %></option><%});%></select></label><label>Booking date <input type="date" name="bookingDate" required min="<%= today %>" value="<%= today %>"></label><div class="booking-note">🔒 Service prices are retrieved from the database when you book. Payment status stays pending.</div><button type="submit" class="btn btn-primary btn-block">Create pending booking →</button><a href="/bookings" class="text-link centered">View my booking history</a></form><% } %></section></div>
<%- include('partials/footer') %>
