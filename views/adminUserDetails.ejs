<%- include('partials/header',{title:'User details'}) %>
<div class="page-heading"><span class="eyebrow">ADMIN WORKSPACE</span><h1><%= user.name %>'s <em>records.</em></h1><p>Username: <%= user.username %> · Role: <%= user.role %></p><a href="/admin/users" class="text-link">← Back to all users</a></div>
<section class="surface"><div class="card-heading"><h2>Pets (<%= pets.length %>)</h2></div><div class="admin-pet-grid"><%pets.forEach(function(p){%><div class="admin-pet"><%if(p.image){%><img src="/images/<%= p.image %>" alt=""><%}else{%><span>🐾</span><%}%><strong><%= p.name %></strong><small><%= p.species %> · <%= p.breed %></small></div><%})%><%if(!pets.length){%><p>No pets.</p><%}%></div></section>
<section class="surface section-space"><div class="card-heading"><h2>Journal entries (<%= journals.length %>)</h2></div><%if(!journals.length){%><p>No entries.</p><%}else{%><div class="table-scroll"><table><thead><tr><th>Date</th><th>Pet</th><th>Activity</th><th>Notes</th></tr></thead><tbody><%journals.forEach(function(j){%><tr><td><%= j.entry_date %></td><td><%= j.pet_name %></td><td><%= j.activity %></td><td><%= j.notes||'—' %></td></tr><%})%></tbody></table></div><%}%></section>
<%- include('partials/footer') %>
