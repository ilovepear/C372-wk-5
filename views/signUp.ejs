<%- include('partials/header',{title:'Create account'}) %>
<div class="form-page"><div class="page-heading"><span class="eyebrow">LET'S GET STARTED</span><h1>Welcome to the <em>petcare family.</em></h1><p>Tell us a little about yourself and your first pet.</p></div>
<form action="/signup" method="POST" enctype="multipart/form-data" class="surface form-surface"><h3>01 · Your account</h3><div class="field-grid"><label>Username <input type="text" name="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9_.-]+" autocomplete="username" required placeholder="e.g. petparent01"></label><label>Full name <input name="name" maxlength="100" required placeholder="e.g. Amy Tan"></label></div><label>Password <input type="password" name="password" minlength="8" autocomplete="new-password" required placeholder="At least 8 characters"></label><p class="hint">New accounts are created as pet-owner accounts. Admin access cannot be self-selected.</p><div class="form-divider"></div>
<h3>02 · Meet your pet</h3><div class="field-grid"><label>Pet name <input name="pet_name" maxlength="80" required placeholder="e.g. Mochi"></label><label>Species <input name="species" maxlength="50" required placeholder="e.g. Dog"></label><label>Breed <input name="breed" maxlength="80" required placeholder="e.g. Maltese"></label><label>Age (years) <input type="number" name="age" min="0" max="40" required placeholder="2"></label></div><label>Photo <input type="file" name="pet_image" accept="image/jpeg,image/png,image/webp"></label><p class="hint">Optional. JPG, PNG or WebP, up to 2 MB.</p><button class="btn btn-primary" type="submit">Create my account →</button><p class="auth-switch">Already registered? <a href="/login">Log in</a></p></form></div>
<%- include('partials/footer') %>
