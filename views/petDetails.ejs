<%- include('partials/header',{title:pet.name+' profile'}) %>
<div class="page-heading row-heading"><div><span class="eyebrow">MEET THE FAMILY</span><h1>Say hi to <em><%= pet.name %>!</em> 🐾</h1><p>A little corner dedicated to your favourite companion.</p></div><a href="/pets/<%= pet.id %>/edit" class="btn btn-light">Edit profile ✎</a></div>
<div class="two-cols"><section class="surface pet-detail-card"><% if(pet.image){ %><img class="pet-detail-photo" src="/images/<%= pet.image %>" alt="Photo of <%= pet.name %>"><%}else{%><div class="pet-detail-photo fallback">🐶</div><%}%><h2><%= pet.name %></h2><p><%= pet.species %> · <%= pet.breed %></p><div class="pet-facts"><div><strong><%= pet.age %></strong><span>Years old</span></div><div><strong><%= journalCount %></strong><span>Journal entries</span></div></div><div class="button-row"><a class="btn btn-primary btn-small" href="/journals/new?petId=<%= pet.id %>">+ Journal</a><a class="btn btn-light btn-small" href="/services?petId=<%= pet.id %>">Book care</a></div><form method="POST" action="/pets/<%= pet.id %>/delete" onsubmit="return confirm('Delete <%= pet.name.replaceAll("'",'') %> and all associated records? This cannot be undone.')" class="delete-pet-form"><button class="text-danger" type="submit">Delete this pet</button></form></section>
<section class="surface"><div class="card-heading"><div><span class="eyebrow">A LITTLE LOOK BACK</span><h2>Recent memories</h2></div><a href="/journals?petId=<%= pet.id %>" class="text-link">All entries →</a></div><% if (!recent.length) { %><div class="empty-state"><span>💗</span><p>No journal entries yet. Start with your pet's first adventure.</p></div><% } else { %><div class="timeline"><% recent.forEach(j=>{%><div class="timeline-item"><div class="timeline-dot"></div><div><small><%= j.entry_date %></small><strong><%= j.activity %></strong><p><%= j.notes||'No notes added.' %></p></div></div><%})%></div><% } %></section></div>
<%- include('partials/footer') %>
