<%- include('partials/header',{title:'Journals'}) %>
<div class="page-heading row-heading"><div><span class="eyebrow">THE LITTLE MOMENTS</span><h1>Pet <em>journals.</em></h1><p>Every walk, cuddle and vet visit has a story worth keeping.</p></div><a href="/journals/new<%= pet ? '?petId='+pet.id : '' %>" class="btn btn-primary">+ New entry</a></div>
<div class="two-cols journal-layout"><div class="sidebar-column"><section class="surface"><div class="card-heading"><h3>My pets</h3><a class="text-link" href="/pets/new">+ Add pet</a></div><div class="pet-list"><a class="pet-list-item <%= !filters.petId ? 'selected' : '' %>" href="/journals">🐾 <span>All pets</span><span>→</span></a><% pets.forEach(function(p){ %><a class="pet-list-item <%= filters.petId===p.id ? 'selected' : '' %>" href="/journals?petId=<%= p.id %>"><% if(p.image){%><img src="/images/<%= p.image %>" alt=""><%}else{%><span class="pet-avatar">🐶</span><%}%><span><%= p.name %></span><span>→</span></a><% }); %></div></section>
<% if (pet) { %><section class="surface pet-side-profile"><% if (pet.image) { %><img class="pet-hero-photo" src="/images/<%= pet.image %>" alt="<%= pet.name %>"><% } else { %><div class="pet-hero-fallback">🐾</div><% } %><h3><%= pet.name %> <span class="pet-age"><%= pet.age %> years</span></h3><p><%= pet.breed %> · <%= pet.species %></p><a class="text-link" href="/pets/<%= pet.id %>">View pet profile →</a></section><% } %></div>
<div class="main-column"><section class="surface filter-panel"><form method="GET" action="/journals" class="filter-form"><input type="hidden" name="petId" value="<%= filters.petId > 0 ? filters.petId : '' %>"><label>Search <input name="q" value="<%= filters.q %>" placeholder="Search notes or activity"></label><label>Activity <input name="activity" value="<%= filters.activity %>" placeholder="e.g. Grooming"></label><label>From <input type="date" name="from" value="<%= filters.from || '' %>"></label><label>To <input type="date" name="to" value="<%= filters.to || '' %>"></label><label>Sort <select name="sort"><option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest first</option><option value="oldest" <%= filters.sort==='oldest'?'selected':'' %>>Oldest first</option></select></label><div class="filter-actions"><button class="btn btn-primary btn-small" type="submit">Apply filters</button><a class="btn btn-light btn-small" href="/journals">Reset</a></div></form></section>
<section class="surface"><div class="card-heading"><div><span class="eyebrow">ACTIVITY LOG</span><h2><%= journals.length %> journal <%= journals.length===1?'entry':'entries' %></h2></div><a class="btn btn-secondary btn-small" href="/journals/export?<%= new URLSearchParams({petId:filters.petId>0?filters.petId:'',q:filters.q,activity:filters.activity,from:filters.from||'',to:filters.to||'',sort:filters.sort}).toString() %>">↓ Export CSV</a></div>
<% if (!journals.length) { %><div class="empty-state"><span>📖</span><h3>No stories yet</h3><p>Try changing the filters or add your pet's first journal entry.</p><a href="/journals/new" class="btn btn-primary">Write an entry</a></div><% } else { %><div class="table-scroll"><table><thead><tr><th>Date</th><th>Pet</th><th>Activity</th><th>Notes</th><th>Actions</th></tr></thead><tbody><% journals.forEach(function(j){ %><tr><td class="nowrap"><%= j.entry_date %></td><td><strong><%= j.pet_name %></strong></td><td><span class="tag"><%= j.activity %></span></td><td class="notes-cell"><%= j.notes || '—' %></td><td><div class="action-row"><a href="/journals/edit/<%= j.id %>" class="text-link">Edit</a><form method="POST" action="/journals/delete/<%= j.id %>" onsubmit="return confirm('Delete this journal entry?')"><button type="submit" class="text-danger">Delete</button></form></div></td></tr><% }); %></tbody></table></div><% } %></section></div></div>
<%- include('partials/footer') %>
