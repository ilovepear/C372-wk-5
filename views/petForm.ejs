<%- include('partials/header',{title:pet?'Edit pet':'Add pet'}) %>
<div class="form-page"><div class="page-heading"><span class="eyebrow">YOUR FURRY FAMILY</span><h1><%= pet ? 'Update' : 'Meet' %> your <em>best friend.</em></h1><p>Keep your pet's profile in one place.</p></div>
<form class="surface form-surface" method="POST" action="<%= formAction %>" enctype="multipart/form-data"><div class="field-grid"><label>Pet name <input name="pet_name" required maxlength="80" value="<%= pet?.name || '' %>" placeholder="e.g. Luna"></label><label>Species <input name="species" required maxlength="50" value="<%= pet?.species || '' %>" placeholder="e.g. Cat"></label><label>Breed <input name="breed" required maxlength="80" value="<%= pet?.breed || '' %>" placeholder="e.g. Ragdoll"></label><label>Age (years) <input type="number" name="age" required min="0" max="40" value="<%= pet?.age ?? '' %>"></label></div><label>Pet photo <input type="file" name="pet_image" accept="image/jpeg,image/png,image/webp"></label><p class="hint">JPG, PNG or WebP, maximum 2 MB. <%= pet ? 'Leave blank to keep the current picture.' : 'Optional.' %></p><% if(pet?.image){ %><img class="preview-photo" src="/images/<%= pet.image %>" alt="Current photo of <%= pet.name %>"><% } %><div class="button-row"><button class="btn btn-primary" type="submit"><%= pet ? 'Save changes' : 'Add pet' %> →</button><a href="<%= pet ? '/pets/'+pet.id : '/journals' %>" class="btn btn-light">Cancel</a></div></form></div>
<%- include('partials/footer') %>
