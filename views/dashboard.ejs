<%- include('partials/header',{title:'Overview'}) %>
<section class="page-heading dashboard-head"><div><span class="eyebrow">YOUR DAILY PETCARE</span><h1>Good to see you, <em><%= session.user.name.split(' ')[0] %>!</em> ✨</h1><p>Everything your furry family needs, in one gentle little space.</p></div><a class="btn btn-primary" href="/pets/new">+ Add a pet</a></section>
<div class="stats-grid"><div class="stat-card"><span class="stat-icon peach">🐾</span><div class="stat-value"><%= petCount %></div><strong>My pets</strong><span class="hint">Furry family members</span></div><div class="stat-card"><span class="stat-icon lavender">📔</span><div class="stat-value"><%= journalCount %></div><strong>Journal entries</strong><span class="hint">Memories saved</span></div><div class="stat-card"><span class="stat-icon sage">✂️</span><div class="stat-value"><%= bookingCount %></div><strong>Bookings</strong><span class="hint">Pet care plans</span></div></div>
<div class="two-cols section-space"><section class="surface"><div class="card-heading"><div><span class="eyebrow">NEXT STEPS</span><h2>What would you like to do?</h2></div></div><div class="quick-links"><a href="/journals"><span>📔</span><div><strong>My pet journals</strong><small>See activity and health records</small></div><b>→</b></a><a href="/services"><span>✂️</span><div><strong>Book a service</strong><small>Grooming and other pet care</small></div><b>→</b></a><a href="/reminders"><span>🔔</span><div><strong>Care reminders</strong><small>Stay on top of upcoming tasks</small></div><b>→</b></a></div></section>
<section class="surface"><div class="card-heading"><div><span class="eyebrow">KEEP IT IN MIND</span><h2>Upcoming care</h2></div><a href="/reminders" class="text-link">View all →</a></div><% if (!pendingReminders.length) { %><div class="empty-inline"><div>☀️</div><p>All caught up! Add a reminder for your next pet care task.</p><a href="/reminders" class="text-link">Create reminder →</a></div><% } else { %><div class="reminder-mini"><% pendingReminders.forEach(item=>{ %><div><span class="mini-check">○</span><div><strong><%= item.task %></strong><small><%= item.pet_name %> · <%= item.due_date %></small></div></div><% }) %></div><% } %></section></div>
<%- include('partials/footer') %>
