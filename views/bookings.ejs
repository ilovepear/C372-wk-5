<%- include('partials/header',{title:'My bookings'}) %>
<div class="page-heading row-heading"><div><span class="eyebrow">YOUR CARE PLANS</span><h1>Booking <em>history.</em></h1><p>All your pets' planned care, with clear statuses and prices.</p></div><a class="btn btn-primary" href="/services">+ Book service</a></div>
<section class="surface"><% if(!bookings.length){ %><div class="empty-state"><span>🗓️</span><h3>No bookings yet</h3><p>Give your furry friend a little treat by booking their first care service.</p><a href="/services" class="btn btn-primary">Explore services</a></div><% }else{%><div class="table-scroll"><table><thead><tr><th>Booking</th><th>Date</th><th>Pet</th><th>Service</th><th>Price</th><th>Booking status</th><th>Payment status</th></tr></thead><tbody><% bookings.forEach(function(b){ %><tr><td>#<%= b.id %></td><td class="nowrap"><%= b.booking_date %></td><td><%= b.pet_name %></td><td><strong><%= b.service_name %></strong></td><td class="nowrap">S$<%= money(b.booked_price) %></td><td><span class="pill"><%= b.booking_status %></span></td><td><span class="pill <%= b.payment_status ? '' : 'pill-soft' %>"><%= b.payment_status || 'No payment record' %></span></td></tr><% }); %></tbody></table></div><div class="booking-footnote">ℹ️ The app stores booking and payment records as pending. It does not process real payments.</div><%}%></section>
<%- include('partials/footer') %>
