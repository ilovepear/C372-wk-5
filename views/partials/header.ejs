<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="PetCareApp - all your pets' care, journals and appointments in one place">
  <title><%= title %> | PetCareApp</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-nav">
    <div class="nav-inner">
      <a class="brand" href="/"><span class="brand-icon">✿</span> petcare<span class="brand-accent">.</span></a>
      <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="main-nav" aria-expanded="false" onclick="const n=document.getElementById('main-nav');const open=n.classList.toggle('open');this.setAttribute('aria-expanded',open)">☰</button>
      <nav id="main-nav" class="nav-links" aria-label="Main navigation">
        <% if (session && session.user) { %>
          <a href="/dashboard">Overview</a>
          <a href="/journals">Journals</a>
          <a href="/services">Services</a>
          <a href="/bookings">Bookings</a>
          <a href="/reminders">Reminders</a>
          <% if (session.user.role === 'admin') { %><a href="/admin/users">Admin</a><% } %>
          <a href="/profile" class="nav-user" title="Edit profile">◎ <%= session.user.name %></a>
          <a href="/logout" class="nav-outline">Sign out</a>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/signup" class="nav-outline">Get started</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="page-wrap">
    <% (messages || []).forEach(function(message) { %>
      <div class="alert alert-success" role="status"><span>✓</span> <%= message %></div>
    <% }); %>
    <% (errors || []).forEach(function(message) { %>
      <div class="alert alert-error" role="alert"><span>!</span> <%= message %></div>
    <% }); %>
