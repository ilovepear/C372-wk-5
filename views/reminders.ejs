<%- include('partials/header',{title:'Care reminders'}) %>
<div class="page-heading"><span class="eyebrow">A LITTLE NUDGE</span><h1>Care <em>reminders.</em></h1><p>Because the most important moments deserve a reminder.</p></div>
<div class="two-cols reminder-layout"><section class="surface"><span class="eyebrow">NEW REMINDER</span><h2>Something to remember?</h2><% if(!pets.length){ %><p>Please <a href="/pets/new">add a pet</a> first.</p><% }else{ %><form action="/reminders" method="POST" class="form-stack"><label>For which pet? <select name="petId" required><option value="">Select a pet</option><%pets.forEach(function(p){%><option value="<%= p.id %>"><%= p.name %></option><%})%></select></label><label>Task <input name="task" required maxlength="120" placeholder="e.g. Monthly grooming"></label><label>Due date <input type="date" name="dueDate" required value="<%= today %>"></label><button type="submit" class="btn btn-primary btn-block">+ Add reminder</button></form><%}%></section>
<section class="surface"><div class="card-heading"><div><span class="eyebrow">STAY ON TOP</span><h2>My care checklist</h2></div><span class="tag"><%= reminders.filter(r=>!r.is_done).length %> to do</span></div><% if(!reminders.length){%><div class="empty-state"><span>🔔</span><h3>Nothing on your list</h3><p>Add a task to keep your pet's care on track.</p></div><%}else{%><div class="task-list"><%reminders.forEach(function(r){%><div class="task-item <%= r.is_done?'task-done':'' %>"><form method="POST" action="/reminders/<%= r.id %>/toggle"><input name="done" value="<%= r.is_done?0:1 %>" type="hidden"><button class="round-check" type="submit" title="<%= r.is_done?'Mark incomplete':'Mark complete' %>"><%= r.is_done?'✓':'' %></button></form><div class="task-details"><strong><%= r.task %></strong><small><%= r.pet_name %> · Due <%= r.due_date %></small></div><form method="POST" action="/reminders/<%= r.id %>/delete" onsubmit="return confirm('Delete this reminder?')"><button type="submit" class="text-danger" title="Delete reminder">✕</button></form></div><%})%></div><%}%></section></div>
<%- include('partials/footer') %>
