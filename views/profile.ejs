<%- include('partials/header',{title:'My profile'}) %>
<div class="form-page"><div class="page-heading"><span class="eyebrow">YOUR ACCOUNT</span><h1>Your little <em>corner.</em></h1><p>Manage how your name appears across petcare.</p></div><section class="surface form-surface"><div class="profile-avatar">◎</div><h2><%= session.user.name %></h2><p class="subtle">Username: @<%= session.user.username %> · <%= session.user.role %></p><form method="POST" action="/profile" class="form-stack"><label>Display name <input name="name" required maxlength="100" minlength="2" value="<%= session.user.name %>"></label><button class="btn btn-primary" type="submit">Save profile →</button></form><p class="hint">Username and role changes are restricted to protect account access.</p></section></div>
<%- include('partials/footer') %>
