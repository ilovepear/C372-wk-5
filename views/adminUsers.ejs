<%- include('partials/header',{title:'Manage users'}) %>
<div class="page-heading"><span class="eyebrow">ADMIN WORKSPACE</span><h1>Manage <em>users.</em></h1><p>Access is restricted to administrator accounts.</p></div><section class="surface"><div class="table-scroll"><table><thead><tr><th>ID</th><th>Username</th><th>Name</th><th>Role</th><th>Actions</th></tr></thead><tbody><%users.forEach(function(u){%><tr><td>#<%= u.id %></td><td><%= u.username %></td><td><%= u.name %></td><td><span class="tag"><%= u.role %></span></td><td><div class="action-row"><a href="/admin/users/<%= u.id %>" class="text-link">Details</a><% if(u.role!=='admin'){%><form method="POST" action="/admin/users/delete/<%= u.id %>" onsubmit="return confirm('Delete this user and all their data?')"><button class="text-danger" type="submit">Delete</button></form><%}%></div></td></tr><%})%></tbody></table></div></section>
<%- include('partials/footer') %>
